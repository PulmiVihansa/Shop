// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  customerId  String?  @unique
  name        String
  email       String   @unique
  password    String?
  provider    String   @default("local")
  googleId    String?   @unique
  avatar      String?
  role        String   @default("user")
  orders      Order[]
  customer    Customer?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id           String        @id @default(cuid())
  customerId   String        @unique
  userId       String?       @unique
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  name         String
  email        String
  phone        String        @default("")
  orders       Order[]
  transactions Transaction[]
  invoices     Invoice[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String?  @unique
  price       Float
  description String   @default("")
  collection  String   @default("men")
  category    String
  colors      String[] @default([])
  images      String[] @default([])
  sizes       String[] @default([])
  stock       Int      @default(0)
  sizeStock   Json     @default("{\"XS\":0,\"S\":0,\"M\":0,\"L\":0,\"XL\":0,\"XXL\":0}")
  badges      String[] @default([])
  material    String   @default("")
  fabric      String   @default("")
  fit         String   @default("")
  careInstructions String @default("")
  countryOfOrigin String @default("")
  metaTitle   String   @default("")
  metaDescription String @default("")
  metaKeywords String[] @default([])
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  reviews     Json     @default("[]")
  featuredProducts FeaturedProduct[]
  saleCampaigns SaleCampaign[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([collection, createdAt])
  @@index([collection, category, createdAt])
  @@index([stock])
}

model Order {
  id                String       @id @default(cuid())
  orderId           String       @unique
  customerId        String
  customer          Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  userId            String?
  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactionId     String?      @unique
  transaction       Transaction? @relation("OrderTransactionFk", fields: [transactionId], references: [id], onDelete: SetNull)
  transactionRecord Transaction? @relation("TransactionOrderFk")
  invoice           Invoice?
  productName       String
  size              String       @default("One Size")
  quantity          Int          @default(1)
  price             Float
  shippingCost      Float        @default(0)
  totalAmount       Float
  status            String       @default("pending")
  orderStatus       String       @default("PENDING")
  paymentStatus     String       @default("PENDING")
  address           Json         @default("{}")
  items             Json         @default("[]")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([customerId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus, createdAt])
  @@index([orderStatus, createdAt])
}

model Transaction {
  id             String    @id @default(cuid())
  transactionId  String    @unique
  orderId        String    @unique
  order          Order     @relation("TransactionOrderFk", fields: [orderId], references: [id], onDelete: Cascade)
  orderReference Order?    @relation("OrderTransactionFk")
  customerId     String
  customer       Customer  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  amount         Float
  paymentMethod  String
  paymentStatus  String    @default("PENDING")
  invoice        Invoice?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([customerId])
  @@index([paymentStatus])
  @@index([createdAt])
}

model Invoice {
  id            String      @id @default(cuid())
  invoiceId     String      @unique
  orderId       String      @unique
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName  String      @default("")
  customerEmail String      @default("")
  customerPhone String      @default("")
  customerAddress Json      @default("{}")
  subtotal      Float
  shipping      Float       @default(0)
  discount      Float       @default(0)
  tax           Float       @default(0)
  grandTotal    Float
  status        String      @default("Paid")
  pdfUrl        String      @default("")
  emailSent     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model Expense {
  id        String   @id @default(cuid())
  title     String
  category  String
  amount    Float
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, date])
  @@index([date])
}

model FinanceTransaction {
  id            String   @id @default(cuid())
  transactionId String   @unique
  category      String
  type          String
  amount        Float
  status        String   @default("Completed")
  reference     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, createdAt])
  @@index([type, status])
  @@index([createdAt])
}

model GiftVoucher {
  id             String    @id @default(cuid())
  voucherCode    String    @unique
  amount         Float
  recipientName  String
  recipientEmail String
  senderEmail    String
  message        String    @default("")
  status         String    @default("ACTIVE")
  pdfUrl         String    @default("")
  purchasedAt    DateTime  @default(now())
  redeemedAt     DateTime?
  orderId        String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, purchasedAt])
  @@index([recipientEmail])
  @@index([senderEmail])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id             String   @id @default(cuid())
  storeName      String   @default("ATELIER")
  logoUrl        String   @default("")
  whatsappNumber String   @default("")
  currency       String   @default("LKR")
  contactEmail   String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PaymentSettings {
  id                  String   @id @default(cuid())
  paymentProvider     String   @default("PayHere")
  merchantId          String   @default("")
  merchantSecret      String   @default("")
  currency            String   @default("LKR")
  enableCOD           Boolean  @default(true)
  enableOnlinePayment Boolean  @default(false)
  sandboxMode         Boolean  @default(true)
  whatsappNumber      String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model HomepageContent {
  id                 String   @id @default(cuid())
  heroTitle          String   @default("")
  heroSubtitle       String   @default("")
  heroImage          String   @default("")
  heroImageSecondary String   @default("")
  buttonText         String   @default("")
  buttonLink         String   @default("")
  section2Title      String   @default("")
  section2Image      String   @default("")
  featuredCategories String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String   @default("")
  link      String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageContent {
  id        String   @id @default(cuid())
  pageName  String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BulkCustomer {
  id            String             @id @default(cuid())
  companyName   String
  contactPerson String
  email         String
  phone         String             @default("")
  discount      Float              @default(0)
  notes         String             @default("")
  orders        BulkOrderRequest[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@index([companyName])
}

model BulkOrderRequest {
  id             String           @id @default(cuid())
  companyName    String
  contactPerson  String
  email          String
  phone          String           @default("")
  products       String[]         @default([])
  quantity       Int              @default(0)
  orderValue     Float            @default(0)
  message        String           @default("")
  status         String           @default("Pending")
  bulkCustomerId String?
  bulkCustomer   BulkCustomer?    @relation(fields: [bulkCustomerId], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([bulkCustomerId])
  @@index([status])
  @@index([createdAt])
}

model FeaturedProduct {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  displayOrder Int @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([productId])
  @@index([isActive, displayOrder])
}

model SaleCampaign {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  originalPrice      Float
  salePrice          Float
  discountPercentage Float @default(0)
  badge              String   @default("")
  startDate          DateTime
  endDate            DateTime
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId])
  @@index([isActive, startDate, endDate])
  @@index([createdAt])
}

