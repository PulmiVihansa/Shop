# Runtime
NODE_ENV=production
PORT=5000
NODE_TLS_REJECT_UNAUTHORIZED=1

# Public URLs
FRONTEND_URL=https://your-domain.com
BACKEND_PUBLIC_URL=https://api.your-domain.com
CORS_ORIGIN=https://your-domain.com

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DIRECT_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret
ALLOW_ADMIN_SIGNUP=false
ADMIN_NAME=Astravia Admin
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-before-seeding

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.your-domain.com/api/auth/google/callback

# Payments / PayHere
PAYMENT_PROVIDER=PayHere
PAYMENT_CURRENCY=LKR
ENABLE_COD=true
ENABLE_ONLINE_PAYMENT=true
PAYHERE_SANDBOX=true
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYMENT_RETURN_URL=https://your-domain.com/order-success
PAYMENT_CANCEL_URL=https://your-domain.com/checkout
PAYMENT_NOTIFY_URL=https://api.your-domain.com/api/payment/notify

# Store contact
STORE_WHATSAPP=94770000000

# Mail / invoices / gift vouchers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Astravia <orders@your-domain.com>
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_LOGO_URL=https://your-domain.com/models/logo.png
INVOICE_FROM_EMAIL=Astravia <orders@your-domain.com>
VOUCHER_FROM_EMAIL=Astravia <gifts@your-domain.com>

# AI try-on
VTON_ENGINE_MODEL=catvton
VTON_ENGINE_ENDPOINT=

# Optional debug flags
DEBUG=
NO_COLOR=
PRISMA_CLIENT_GET_TIME=
PRISMA_QUERY_ENGINE_LIBRARY=
